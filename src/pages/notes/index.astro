---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Search from 'astro-pagefind/components/Search.astro';
import { listNotes, listNoteCategories } from '../../lib/data/notes';

const notes = await listNotes();
const categories = await listNoteCategories();
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="技术笔记 - SlivenNoxLab" description="日常心得、踩坑记录与技术探索。">
  <main id="main" class="container notes-page">
    <Reveal>
      <SectionHead title="技术笔记" href="/admin/" linkLabel="内容后台" />
    </Reveal>

    <Reveal delay={60}>
      <p class="notes-intro">
        日常心得与踩坑记录，支持<a class="content-link" href="/admin/">网页内写作发布</a>。
        碎片形态，积累之后沉淀成结构化知识。
      </p>
    </Reveal>

    {
      categories.length > 1 && (
        <Reveal delay={90}>
          <div class="cat-tabs" role="tablist" aria-label="笔记分类">
            <button class={`cat-tab is-active ${''}`} type="button" role="tab" aria-selected="true" data-cat="all">
              全部
            </button>
            {categories.map((c) => (
              <button class="cat-tab" type="button" role="tab" aria-selected="false" data-cat={c.key}>
                {c.label}
              </button>
            ))}
          </div>
        </Reveal>
      )
    }

    <Reveal delay={110}>
      <div class="notes-search">
        <Search id="notes-search" className="pagefind-ui" uiOptions={{ showImages: false }} />
      </div>
    </Reveal>

    <Reveal delay={140}>
      <ul class="note-list" role="list">
        {
          notes.map((note) => (
            <li class="note-row" data-cat={note.data.category ?? 'uncategorized'}>
              <a class="note-link" href={`/notes/${note.id}/`}>
                <span class="note-date">
                  {fmt(note.data.pubDate)}
                </span>
                <span class="note-body">
                  <span class="note-title">{note.data.title}</span>
                  {note.data.description && <span class="note-desc">{note.data.description}</span>}
                  <span class="note-tags">
                    {note.data.category && <span class="tag-mini tag-cat">{note.data.category}</span>}
                    {note.data.tags.map((t) => (
                      <span class="tag-mini">{t}</span>
                    ))}
                  </span>
                </span>
              </a>
              <a
                class="note-edit"
                href={`/admin/#/collections/notes/entries/${note.id}`}
                aria-label={`在后台编辑「${note.data.title}」`}
                title="在后台编辑"
              >
                编辑
              </a>
            </li>
          ))
        }
      </ul>
    </Reveal>

    {
      notes.length === 0 && (
        <p class="notes-empty">还没有笔记。去内容后台写第一篇。</p>
      )
    }
  </main>
</BaseLayout>

<script>
  // 分类筛选（纯客户端）；ClientRouter 下随 astro:page-load 对新页重新绑定
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
    const rows = document.querySelectorAll<HTMLElement>('.note-row');
    tabs.forEach((tab) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = '1';
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        const key = tab.dataset.cat;
        rows.forEach((row) => {
          const show = key === 'all' || row.dataset.cat === key;
          row.style.display = show ? '' : 'none';
        });
      });
    });
  });
</script>

<style>
  .notes-intro {
    max-width: 56ch;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .cat-tab {
    font-size: 0.9rem;
    padding: 8px 17px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .cat-tab:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .cat-tab.is-active {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tag-cat {
    color: var(--color-interactive);
    border-color: rgba(34, 211, 238, 0.35);
  }

  .notes-search {
    margin-bottom: var(--space-8);
    max-width: 620px;
  }

  .note-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .note-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .note-link {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-2);
    text-decoration: none;
    border-radius: var(--radius-input);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .note-link:hover {
    background: rgba(168, 157, 220, 0.05);
  }

  /* 行内编辑直达：默认低调，悬停浮现 */
  .note-edit {
    font-size: 0.82rem;
    color: var(--color-text-tertiary);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-input);
    text-decoration: none;
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .note-row:hover .note-edit {
    opacity: 1;
  }

  .note-edit:hover {
    color: var(--color-interactive);
  }

  @media (pointer: coarse) {
    .note-edit {
      opacity: 1;
    }
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-tertiary);
    padding-top: 4px;
    white-space: nowrap;
  }

  .note-body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .note-title {
    font-weight: 550;
    font-size: 1.02rem;
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .note-link:hover .note-title {
    color: var(--color-accent-soft);
  }

  .note-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .tag-mini {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-tertiary);
  }

  .notes-empty {
    color: var(--color-text-tertiary);
    padding: var(--space-8) 0;
  }

  @media (max-width: 640px) {
    .note-link {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

<style>
  /* Pagefind UI 换肤：对齐站点 token */
  .notes-search .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent-soft);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg-raised);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: rgba(168, 157, 220, 0.12);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: inherit;
  }

  .notes-search .pagefind-ui .pagefind-ui__search-input {
    background: var(--color-bg-raised);
  }

  .notes-search .pagefind-ui .pagefind-ui__search-input:focus {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }

  .notes-search .pagefind-ui .pagefind-ui__result-link {
    color: var(--color-text);
  }

  .notes-search .pagefind-ui .pagefind-ui__result-excerpt mark {
    background: rgba(124, 58, 237, 0.35);
    color: var(--color-text);
  }
</style>
