---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PlayerDeck from '../../components/player/PlayerDeck.astro';
import { musicTracks } from '../../lib/data/music';
---

<BaseLayout title="音乐播放器 - SlivenNoxLab 工具台" description="Web Audio 环形频谱可视化音乐播放器。">
  <main id="main" class="container music-page">
    <Reveal>
      <SectionHead title="音乐播放器" href="/lab/" linkLabel="工具台" />
    </Reveal>

    <Reveal delay={60}>
      <div class="stage">
        <div class="glow" aria-hidden="true"></div>
        <PlayerDeck />
      </div>
    </Reveal>

    <Reveal delay={120}>
      <div class="drops-head">曲目列表</div>
      <ul class="plist" role="list">
        {
          musicTracks.map((t, i) => (
            <li class="prow-wrap">
              <button class="prow" data-index={i} type="button">
                <span class="prow-idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="prow-name">{t.title}</span>
                <span class="prow-artist">{t.artist}</span>
                <span class="prow-eq" aria-hidden="true">
                  <i /><i /><i />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </Reveal>

    <Reveal delay={180}>
      <p class="music-note">
        示例曲目为程序合成（<code class="mono-code">scripts/synth-demo-music.py</code>）。
        换成自己的音乐：音频放入 <code class="mono-code">public/music/</code>，
        在 <code class="mono-code">src/lib/data/music.ts</code> 加一行。公开站点请只放拥有版权的音频。
      </p>
    </Reveal>
  </main>
</BaseLayout>

<script>
  // 播放列表行：点击切歌；当前行高亮（ClientRouter 下随导航重跑）
  const apiOf = () => (window as unknown as Record<string, unknown>).NoxAudio;
  const rows = document.querySelectorAll<HTMLButtonElement>('.prow');
  rows.forEach((row) => {
    row.addEventListener('click', () => apiOf()?.load(Number(row.dataset.index)));
  });

  const syncRows = () => {
    const api = apiOf();
    if (!api) return;
    rows.forEach((row) => {
      row.classList.toggle('is-current', Number(row.dataset.index) === api.index);
      row.querySelector('.prow-eq')?.classList.toggle('is-playing', !api.audio.paused);
    });
  };
  window.addEventListener('noxaudio:state', syncRows);
  syncRows();
</script>

<style>
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: var(--space-8) var(--space-6);
  }

  .glow {
    position: absolute;
    inset: -8% -12%;
    background:
      radial-gradient(42% 46% at 50% 42%, rgba(124, 58, 237, 0.28), transparent 70%),
      radial-gradient(30% 36% at 50% 88%, rgba(34, 211, 238, 0.1), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }

  .plist-head,
  .drops-head {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: 0.9rem;
    color: var(--color-text-tertiary);
  }

  .plist {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .prow {
    display: grid;
    grid-template-columns: 3em 1fr auto auto;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-4) var(--space-2);
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .prow:hover {
    background: rgba(168, 157, 220, 0.05);
  }

  .prow-idx {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .prow-name {
    font-weight: 550;
    font-size: 0.98rem;
    color: var(--color-text);
  }

  .prow-artist {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* 当前播放行的均衡器动画 */
  .prow-eq {
    display: none;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }

  .prow.is-current .prow-eq {
    display: inline-flex;
  }

  .prow-eq i {
    width: 3px;
    height: 100%;
    background: var(--color-interactive);
  }

  .prow-eq.is-playing i {
    animation: eq 0.9s ease-in-out infinite;
  }

  .prow-eq.is-playing i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .prow-eq.is-playing i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.4);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .music-note {
    margin-top: var(--space-10);
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    line-height: 1.8;
  }

  .mono-code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(168, 157, 220, 0.12);
    color: var(--color-accent-soft);
  }

  @media (max-width: 640px) {
    .prow {
      grid-template-columns: 2.5em 1fr auto;
    }

    .prow-artist {
      display: none;
    }
  }
</style>
