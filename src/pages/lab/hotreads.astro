---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { listHotReads } from '../../lib/data/hotreads';

const hotreads = await listHotReads();
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="AI 热点解读 - SlivenNoxLab 工具台" description="每日定时抓取技术资讯，DeepSeek 生成中文摘要。">
  <main id="main" class="container container-narrow">
    <Reveal>
      <SectionHead title="AI 热点解读" />
    </Reveal>

    <Reveal delay={60}>
      <p class="hot-intro">
        每日由 GitHub Actions 定时任务抓取技术资讯（机器之心、量子位、阮一峰周刊、HelloGitHub、
        Hacker News 精选），调用 DeepSeek 生成中文摘要后自动发布到本页。
      </p>
    </Reveal>

    <Reveal delay={100}>
      <div class="hot-pipeline">
        <div class="hot-step">
          <span class="hot-step-label">RSS 拉取</span>
          <span class="hot-step-text">五路技术源，cron 定时触发</span>
        </div>
        <div class="hot-step">
          <span class="hot-step-label">LLM 摘要</span>
          <span class="hot-step-text">DeepSeek 生成中文要点</span>
        </div>
        <div class="hot-step">
          <span class="hot-step-label">自动发布</span>
          <span class="hot-step-text">写入内容目录，构建后上线</span>
        </div>
      </div>
    </Reveal>

    {
      hotreads.length > 0 ? (
        <div class="hot-list">
          {hotreads.map((item, i) => (
            <Reveal delay={Math.min(i * 60, 240)}>
              <a class="hot-item" href={`/lab/hotreads/${item.id}/`}>
                <span class="hot-item-date">{fmt(item.data.pubDate)}</span>
                <span class="hot-item-title">{item.data.title}</span>
                {item.data.description && <span class="hot-item-desc">{item.data.description}</span>}
              </a>
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal delay={140}>
          <p class="hot-empty">流水线随部署上线后，这里会出现每一天的热点摘要。</p>
        </Reveal>
      )
    }
  </main>
</BaseLayout>

<style>
  .hot-intro {
    max-width: 60ch;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-8);
  }

  .hot-pipeline {
    display: grid;
    gap: var(--space-4);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .hot-step {
    display: grid;
    gap: var(--space-1);
  }

  .hot-step-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-interactive);
  }

  .hot-step-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .hot-list {
    display: grid;
  }

  .hot-item {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-2);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .hot-item:hover {
    background: rgba(168, 157, 220, 0.05);
  }

  .hot-item-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .hot-item-title {
    font-weight: 550;
    font-size: 1.02rem;
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hot-item:hover .hot-item-title {
    color: var(--color-accent-soft);
  }

  .hot-item-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hot-empty {
    color: var(--color-text-tertiary);
    font-size: 0.9rem;
  }
</style>
