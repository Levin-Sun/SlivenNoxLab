---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
---

<BaseLayout title="AI 热点解读 - SlivenNoxLab 工具台" description="每日定时抓取技术资讯，LLM 生成中文摘要。">
  <main id="main" class="container container-narrow">
    <Reveal>
      <SectionHead title="AI 热点解读" />
    </Reveal>

    <Reveal delay={60}>
      <p class="hot-intro">
        每日由 GitHub Actions 定时任务抓取技术资讯（机器之心、量子位、阮一峰周刊、HelloGitHub、
        Hacker News 精选），调用 DeepSeek 生成中文摘要后自动发布到本页。
      </p>
    </Reveal>

    <Reveal delay={120}>
      <div class="hot-pipeline">
        <div class="hot-step">
          <span class="hot-step-label">RSS 拉取</span>
          <span class="hot-step-text">五路技术源，cron 定时触发</span>
        </div>
        <div class="hot-step">
          <span class="hot-step-label">LLM 摘要</span>
          <span class="hot-step-text">DeepSeek 生成中文要点</span>
        </div>
        <div class="hot-step">
          <span class="hot-step-label">自动发布</span>
          <span class="hot-step-text">写入内容目录，构建后上线</span>
        </div>
      </div>
    </Reveal>

    <Reveal delay={160}>
      <p class="hot-empty">
        流水线随阶段四部署上线后，这里会出现每一天的热点摘要。
      </p>
    </Reveal>
  </main>
</BaseLayout>

<style>
  .hot-intro {
    max-width: 60ch;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-8);
  }

  .hot-pipeline {
    display: grid;
    gap: var(--space-4);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .hot-step {
    display: grid;
    gap: var(--space-1);
  }

  .hot-step-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-interactive);
  }

  .hot-step-text {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
  }

  .hot-empty {
    color: var(--color-text-tertiary);
    font-size: 0.9rem;
  }
</style>
