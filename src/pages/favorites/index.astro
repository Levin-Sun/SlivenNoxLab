---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import SpotlightCard from '../../components/ui/SpotlightCard.astro';
import { autoIcon, favoriteCategories } from '../../lib/data/favorites';

const total = favoriteCategories.reduce((n, c) => n + c.items.length, 0);
---

<BaseLayout title="收藏夹 - SlivenNoxLab" description="常用网站、skill 与片单收藏，后台可增删改查。">
  <main id="main" class="container">
    <Reveal>
      <SectionHead title="收藏夹" href="/admin/#/collections/favorites" linkLabel="管理收藏" />
    </Reveal>

    <Reveal delay={50}>
      <div class="fav-tabs" role="tablist" aria-label="收藏分类">
        {
          favoriteCategories.map((c, i) => (
            <button
              class={`fav-tab ${i === 0 ? 'is-active' : ''}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={c.key}
            >
              {c.label}
              <span class="fav-count">{c.items.length}</span>
            </button>
          ))
        }
      </div>
    </Reveal>

    {
      favoriteCategories.map((c, ci) => (
        <div class={`fav-panel ${ci === 0 ? 'is-active' : ''}`} data-panel={c.key} role="tabpanel">
          {c.items.length > 0 ? (
            <div class="fav-grid">
              {c.items.map((item, i) => (
                <Reveal delay={Math.min(i * 40, 240)}>
                  <SpotlightCard href={item.href}>
                    <div class="fav-card-inner">
                      {item.cover && (
                        <div class="fav-cover">
                          <img src={item.cover} alt={`${item.name} 封面`} loading="lazy" decoding="async" />
                        </div>
                      )}
                      <div class="fav-card-head">
                        {autoIcon(item) && (
                          <span class="fav-icon">
                            <img
                              src={autoIcon(item)}
                              alt=""
                              loading="lazy"
                              decoding="async"
                              onerror="this.style.display='none'; this.nextElementSibling?.style.removeProperty('display')"
                            />
                            <span class="fav-icon-fallback" style="display:none" aria-hidden="true">
                              {item.name.slice(0, 1)}
                            </span>
                          </span>
                        )}
                        <span class="fav-name">{item.name}</span>
                        {item.host && <span class="fav-host">{item.host}</span>}
                      </div>
                      <span class="fav-desc">{item.desc}</span>
                    </div>
                  </SpotlightCard>
                </Reveal>
              ))}
            </div>
          ) : (
            <p class="fav-empty">这一类还在攒，看到好的会记进来。去<a class="content-link" href="/admin/#/collections/favorites">后台</a>添加。</p>
          )}
        </div>
      ))
    }

    <Reveal delay={160}>
      <p class="fav-foot">
        共 {total} 条 · 增删改查在后台"收藏夹"集合：条目支持自定义图标与封面图，
        网站类不传图标会自动抓取站点 favicon。
      </p>
    </Reveal>
  </main>
</BaseLayout>

<script>
  // 分类 tab 切换（无依赖）；ClientRouter 下随 astro:page-load 重新绑定
  const tabs = document.querySelectorAll<HTMLButtonElement>('.fav-tab');
  const panels = document.querySelectorAll<HTMLElement>('.fav-panel');
  tabs.forEach((tab) => {
    if (tab.dataset.bound) return;
    tab.dataset.bound = '1';
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === key));
    });
  });
</script>

<style>
  .fav-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .fav-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.92rem;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .fav-tab:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .fav-tab.is-active {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .fav-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .fav-panel {
    display: none;
  }

  .fav-panel.is-active {
    display: block;
  }

  .fav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .fav-grid > :global(.reveal) {
    display: grid;
  }

  .fav-card-inner {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    height: 100%;
    align-content: start;
  }

  /* 封面（影视海报等） */
  .fav-cover {
    border-radius: var(--radius-input);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .fav-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .fav-card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .fav-icon {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: rgba(168, 157, 220, 0.1);
    border: 1px solid var(--color-border);
    overflow: hidden;
    flex-shrink: 0;
  }

  .fav-icon img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .fav-icon-fallback {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-accent-soft);
  }

  .fav-name {
    font-weight: 550;
    font-size: 1rem;
    color: var(--color-text);
  }

  .fav-host {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .fav-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .fav-empty {
    color: var(--color-text-tertiary);
    padding: var(--space-6) 0;
  }

  .fav-foot {
    margin-top: var(--space-10);
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .fav-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .fav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
