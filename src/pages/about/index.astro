---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { site } from '../../config/site';

const tags = ['LangChain', 'RAG', 'Python', 'TypeScript', 'Astro'];
---

<BaseLayout title="关于我 - SlivenNoxLab" description="效率工具践行者，SlivenNoxLab 站长。">
  <main id="main" class="container container-narrow">
    <Reveal>
      <SectionHead title="关于我" />
    </Reveal>

    <Reveal delay={60}>
      <div class="prose">
        <p>
          我是 Sliven，效率工具践行者。白天写代码，晚上折腾实验室——这个站就是那个实验室：
          自用效率工具台优先，顺便公开作品、笔记和摄影。
        </p>
        <p>
          目前在做的：<a class="content-link" href="/projects/umax-rag/">Umax RAG</a>
          （LangChain 知识库问答系统），以及这个实验室站点本身。
        </p>
        <p>信条是把重复的活交给工具，把省下来的时间还给创造。</p>
      </div>
    </Reveal>

    <Reveal delay={120}>
      <ul class="tag-row" role="list">
        {
          tags.map((t) => (
            <li class="tag">
              {t}
            </li>
          ))
        }
      </ul>
    </Reveal>

    <Reveal delay={160}>
      <p class="contact-line">
        欢迎在 GitHub 找我：
        <a class="content-link" href={site.github} target="_blank" rel="me noopener">
          {site.github.replace('https://', '')}
        </a>
      </p>
    </Reveal>
  </main>
</BaseLayout>

<style>
  .tag-row {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .contact-line {
    color: var(--color-text-secondary);
  }
</style>
