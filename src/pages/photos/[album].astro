---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { albums, getAlbum } from '../../lib/data/photos';

export async function getStaticPaths() {
  return albums.map((album) => ({ params: { album: album.slug }, props: { album } }));
}

const { album } = Astro.props as { album: ReturnType<typeof getAlbum> };
---

<BaseLayout title={`${album?.title ?? '相册'} - SlivenNoxLab 摄影`} description={album?.desc ?? `${album?.title} 相册（${album?.category}），共 ${album?.photos.length} 张照片。`}>
  <main id="main" class="container">
    <a class="back-link content-link" href="/photos/">← 全部相册</a>

    <header class="album-head">
      <div class="album-title-row">
        <h1 class="album-title">{album?.title}</h1>
        {album && <span class="album-cat">{album.category}</span>}
      </div>
      {album?.desc && <p class="album-desc">{album.desc}</p>}
      <span class="album-count">{album?.photos.length ?? 0} 张</span>
    </header>

    {
      album && album.photos.length > 0 ? (
        <div class="masonry">
          {album.photos.map((photo, i) => (
            <Reveal delay={Math.min(i * 30, 240)} class="m-item">
              <figure class="m-item-inner">
                <a href={photo.src.src} target="_blank" rel="noopener" aria-label={`查看原图 ${photo.filename}`}>
                  <Image
                    src={photo.src}
                    alt={`${album.title} ${i + 1}`}
                    width={880}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </a>
              </figure>
            </Reveal>
          ))}
        </div>
      ) : (
        <div class="album-empty">
          <Reveal delay={80}>
            <p class="empty-text">这个相册还没有照片。把图放进</p>
            <p>
              <code class="path-code">src/assets/photos/{album?.slug}/</code>
            </p>
            <p class="empty-text">文件夹，重新构建即自动收录并优化。</p>
          </Reveal>
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin: var(--space-10) 0 var(--space-8);
    font-size: 0.9rem;
  }

  .album-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .album-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .album-title {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.4rem);
    color: var(--color-text);
  }

  .album-cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--color-interactive);
  }

  .album-desc {
    color: var(--color-text-secondary);
  }

  .album-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
  }

  /* 瀑布流：CSS 多列 */
  .masonry {
    columns: 3;
    column-gap: var(--space-4);
  }

  .m-item {
    break-inside: avoid;
    margin: 0 0 var(--space-4);
  }

  .m-item-inner {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }

  .m-item-inner :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  .m-item-inner:hover :global(img) {
    transform: scale(1.01);
  }

  .album-empty {
    padding: var(--space-10);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-card);
    text-align: center;
  }

  .album-empty .path-code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: var(--radius-input);
    background: rgba(168, 157, 220, 0.12);
    color: var(--color-accent-soft);
  }

  .empty-text {
    color: var(--color-text-secondary);
  }

  .album-empty :global(p) {
    margin-bottom: var(--space-3);
  }

  @media (max-width: 900px) {
    .masonry {
      columns: 2;
    }
  }

  @media (max-width: 600px) {
    .masonry {
      columns: 1;
    }
  }
</style>
