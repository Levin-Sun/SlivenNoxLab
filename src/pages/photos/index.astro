---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/ui/Reveal.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { albums, photoCategories } from '../../lib/data/photos';
---

<BaseLayout title="摄影 - SlivenNoxLab" description="相册与摄影作品：人像、风景、街拍。">
  <main id="main" class="container">
    <Reveal>
      <SectionHead title="摄影" />
    </Reveal>

    <Reveal delay={50}>
      <div class="photo-tabs" role="tablist" aria-label="相册分类">
        {
          photoCategories.map((c, i) => (
            <button
              class={`photo-tab ${i === 0 ? 'is-active' : ''}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-filter={c.key}
            >
              {c.label}
            </button>
          ))
        }
      </div>
    </Reveal>

    {
      albums.length > 0 ? (
        <Reveal delay={100}>
          <div class="accordion" data-accordion>
            {albums.map((album, i) => (
              <a
                class={`strip ${i === 0 ? 'is-open' : ''}`}
                href={`/photos/${album.slug}/`}
                data-category={album.category}
                aria-label={`${album.title} 相册，${album.photos.length} 张`}
              >
                {album.coverSrc ? (
                  <Image src={album.coverSrc} alt={`${album.title} 相册封面`} width={720} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                ) : (
                  <img src={album.coverFallback} alt={`${album.title} 相册封面占位图`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                )}
                <span class="strip-veil" aria-hidden="true" />
                <span class="strip-label">
                  <span class="strip-title">{album.title}</span>
                  <span class="strip-meta">{album.desc ?? album.category} · {album.photos.length} 张</span>
                </span>
              </a>
            ))}
          </div>
        </Reveal>
      ) : (
        <Reveal delay={100}>
          <p class="photos-empty">还没有相册。在后台"相册"集合里新建一个，再往对应文件夹丢照片。</p>
        </Reveal>
      )
    }

    <Reveal delay={160}>
      <p class="photos-guide">
        新建相册：后台"相册"集合点新建，填名称与分类；照片丢进
        <code class="path-code">src/assets/photos/相册slug/</code>，构建时自动优化收录。
      </p>
    </Reveal>
  </main>
</BaseLayout>

<script>
  // 分类筛选 + 手风琴交互（hover 展开；触屏点按展开）
  const tabs = document.querySelectorAll<HTMLButtonElement>('.photo-tab');
  const strips = document.querySelectorAll<HTMLElement>('.strip');
  const accordion = document.querySelector<HTMLElement>('[data-accordion]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      const key = tab.dataset.filter;
      let firstVisible = true;
      strips.forEach((strip) => {
        const show = key === 'all' || strip.dataset.category === key;
        strip.classList.toggle('is-hidden', !show);
        strip.classList.toggle('is-open', show && firstVisible);
        if (show) firstVisible = false;
      });
      accordion?.classList.toggle('is-single', strips.length - [...strips].filter((s) => s.classList.contains('is-hidden')).length === 1);
    });
  });

  // 触屏/精确指针点按切换展开条
  strips.forEach((strip) => {
    strip.addEventListener('click', (e) => {
      if (!strip.classList.contains('is-open') && matchMedia('(pointer: coarse)').matches) {
        e.preventDefault();
        strips.forEach((s) => s.classList.toggle('is-open', s === strip));
      }
    });
  });
</script>

<style>
  .photo-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .photo-tab {
    font-size: 0.92rem;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .photo-tab:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .photo-tab.is-active {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Accordion Gallery（ReactBits 同名组件的零依赖移植）：
     横条收拢成窄条，悬停/默认条展开露出整幅封面 */
  .accordion {
    display: flex;
    gap: var(--space-3);
    height: clamp(300px, 46vw, 460px);
  }

  .strip {
    position: relative;
    flex: 1;
    min-width: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: flex 0.65s var(--ease-out);
  }

  .strip.is-open {
    flex: 3.4;
  }

  /* 桌面精确指针：悬停即展开（点击仍是进入相册） */
  @media (pointer: fine) {
    .strip:hover {
      flex: 3.4;
    }

    .strip:hover .strip-meta {
      opacity: 1;
    }
  }

  .strip.is-hidden {
    display: none;
  }

  .accordion.is-single .strip.is-open {
    flex: 1;
  }

  .strip :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 收拢时图片以中心为锚，展开时完整呈现 */
    transition: opacity 0.5s var(--ease-out);
  }

  .strip-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 3, 16, 0.72), rgba(6, 3, 16, 0.05) 55%);
    transition: opacity 0.5s var(--ease-out);
  }

  .strip-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-5);
    display: grid;
    gap: var(--space-1);
    white-space: nowrap;
  }

  .strip-title {
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
  }

  .strip-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(237, 234, 247, 0.78);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out) 0.15s;
  }

  .strip.is-open .strip-meta,
  .strip:hover .strip-meta {
    opacity: 1;
  }

  .photos-empty {
    color: var(--color-text-tertiary);
  }

  .photos-guide {
    margin-top: var(--space-8);
    max-width: 66ch;
    color: var(--color-text-tertiary);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .path-code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(168, 157, 220, 0.12);
    color: var(--color-accent-soft);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    /* 窄屏转为纵向手风琴 */
    .accordion {
      flex-direction: column;
      height: auto;
    }

    .strip {
      height: 84px;
      flex: none;
    }

    .strip.is-open {
      height: 300px;
      flex: none;
    }

    .strip-label {
      padding: var(--space-4);
    }
  }
</style>
