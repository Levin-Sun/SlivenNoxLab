---
// 工具 + 建设日志双栏：全页唯一左右分栏补充位。
// 左：常用工具（配置驱动，收藏夹模块复用同源数据）；右：站点建设日志时间线。
import Reveal from '../ui/Reveal.astro';
import SectionHead from '../ui/SectionHead.astro';
import { tools, timeline } from '../../config/home';
---

<section class="section container">
  <div class="tf-grid">
    <div class="tf-left">
      <Reveal>
        <SectionHead title="常用工具" href="/lab/" linkLabel="全部工具" />
      </Reveal>
      <div class="tool-list">
        {
          tools.map((t, i) => (
            <Reveal delay={i * 45}>
              <a class="tool-row" href={t.href} target="_blank" rel="noopener">
                <span class="tool-name">{t.name}</span>
                <span class="tool-desc">{t.desc}</span>
                <span class="tool-host">{t.host}</span>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>

    <div class="tf-right">
      <Reveal>
        <SectionHead title="建设日志" />
      </Reveal>
      <ol class="feed">
        {
          timeline.map((item, i) => (
            <Reveal delay={i * 60}>
              <li class="feed-item">
                <span class="feed-date">{item.date}</span>
                <span class="feed-text">{item.text}</span>
              </li>
            </Reveal>
          ))
        }
      </ol>
      <Reveal delay={200}>
        <p class="feed-note">笔记模块上线后，这里会换成真实动态流。</p>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .tf-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-14);
    align-items: start;
  }

  /* 工具行：名称 + 说明 + 域名（等宽元信息），整行可点 */
  .tool-list {
    display: grid;
  }

  .tool-row {
    display: grid;
    grid-template-columns: 9.5em 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      padding-left var(--dur-fast) var(--ease-out);
  }

  .tool-list :global(.reveal:first-child) .tool-row {
    border-top: 1px solid var(--color-border);
  }

  .tool-row:hover {
    background: rgba(168, 157, 220, 0.05);
    padding-left: var(--space-3);
  }

  .tool-name {
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .tool-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .tool-host {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary);
  }

  /* 日志时间线：单根细线 + 等宽日期，无装饰点 */
  .feed {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-5);
  }

  .feed-item {
    display: grid;
    gap: var(--space-1);
  }

  .feed-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .feed-text {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .feed-note {
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 900px) {
    .tf-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .tool-row {
      grid-template-columns: 8em 1fr;
    }

    .tool-host {
      display: none;
    }
  }
</style>
