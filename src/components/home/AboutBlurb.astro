---
// 个人简介短区：一段话 + 真实技能标签 + GitHub 入口。文案克制，拒绝填充动词。
import Reveal from '../ui/Reveal.astro';
import SectionHead from '../ui/SectionHead.astro';
import { site } from '../../config/site';

const tags = ['LangChain', 'RAG', 'Python', 'TypeScript', 'Astro'];
---

<section class="section container">
  <Reveal>
    <SectionHead title="关于我" href="/about/" linkLabel="完整介绍" />
  </Reveal>

  <Reveal delay={60}>
    <p class="about-line">
      效率工具践行者：白天写代码，晚上折腾实验室。信条是把重复的活交给工具，
      把省下来的时间还给创造。
    </p>
  </Reveal>

  <Reveal delay={120}>
    <ul class="tag-row" role="list">
      {
        tags.map((t) => (
          <li class="tag">
            {t}
          </li>
        ))
      }
    </ul>
  </Reveal>

  <Reveal delay={180}>
    <a class="btn btn-ghost about-gh" href={site.github} target="_blank" rel="me noopener">
      GitHub 跟我交流
    </a>
  </Reveal>
</section>

<style>
  .about-line {
    max-width: 58ch;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .tag-row {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .about-gh {
    margin-top: var(--space-6);
  }
</style>
