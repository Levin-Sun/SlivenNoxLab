---
// 全局迷你播放条：音频引擎单例（window.NoxAudio）+ 右下角悬浮胶囊。
// 引擎：单个 <audio> + Web Audio Analyser，播放页可视化与迷你条共用同一数据源。
// 状态通过 window 事件 'noxaudio:state' 广播；交互按钮均为自绘几何 SVG。
import { musicTracks } from '../../lib/data/music';
  import { wrapIndex } from '../../lib/contracts/audio';
---

<div class="mini-player" id="mini-player" hidden>
  <a class="mp-open" href="/lab/music/" aria-label="打开音乐播放器">
    <canvas class="mp-vis" width="56" height="26" aria-hidden="true"></canvas>
    <span class="mp-title" id="mp-title">…</span>
  </a>
  <button class="mp-btn" id="mp-toggle" type="button" aria-label="播放 / 暂停">
    <svg class="ic ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
    <svg class="ic ic-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z" /></svg>
  </button>
  <button class="mp-btn mp-close" id="mp-close" type="button" aria-label="关闭迷你播放条">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4L12 13.4 6.4 19 5 17.6 10.6 12 5 6.4 6.4 5z" /></svg>
  </button>
</div>

<script>
  import { musicTracks } from '../../lib/data/music';
  import { wrapIndex } from '../../lib/contracts/audio';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  /* ============ 音频引擎单例 ============ */
  function createEngine() {
    const w = window as unknown as Record<string, unknown>;
    if (w.NoxAudio) return w.NoxAudio as NoxAudio;

    const audio = new Audio();
    audio.preload = 'none';
    audio.volume = 0.8;

    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    const data = new Uint8Array(128);

    const state = {
      tracks: musicTracks,
      index: -1,
      playing: false,
    };

    const emit = () => {
      window.dispatchEvent(
        new CustomEvent('noxaudio:state', {
          detail: { index: state.index, playing: state.playing, title: state.tracks[state.index]?.title ?? '' },
        }),
      );
    };

    const ensureGraph = () => {
      if (ctx) return;
      try {
        ctx = new AudioContext();
        const src = ctx.createMediaElementSource(audio);
        analyser = ctx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.82;
        src.connect(analyser);
        analyser.connect(ctx.destination);
      } catch {
        ctx = null; // Web Audio 不可用时退化为纯播放（无可视化）
      }
    };

    const load = (i: number, autoplay = true) => {
      state.index = wrapIndex(i, state.tracks.length);
      audio.src = state.tracks[state.index].src;
      if (autoplay) play();
      else emit();
    };

    const play = () => {
      ensureGraph();
      ctx?.resume?.();
      audio.play().catch(() => {});
    };

    audio.addEventListener('play', () => {
      state.playing = true;
      emit();
    });
    audio.addEventListener('pause', () => {
      state.playing = false;
      emit();
    });
    audio.addEventListener('ended', () => load(state.index + 1)); // 列表循环
    audio.addEventListener('timeupdate', emit);

    const api: NoxAudio = {
      tracks: state.tracks,
      get index() {
        return state.index;
      },
      get playing() {
        return state.playing;
      },
      audio,
      load,
      toggle() {
        if (state.index < 0) {
          load(0);
          return;
        }
        if (audio.paused) play();
        else audio.pause();
      },
      next() {
        load(state.index + 1);
      },
      prev() {
        load(state.index - 1);
      },
      seekTo(t: number) {
        audio.currentTime = t;
      },
      setVolume(v: number) {
        audio.volume = v;
      },
      freq() {
        if (!analyser || !state.playing) return null;
        analyser.getByteFrequencyData(data);
        return data;
      },
    };

    w.NoxAudio = api;
    return api;
  }

  interface NoxAudio {
    tracks: Array<{ title: string; artist: string; src: string }>;
    readonly index: number;
    readonly playing: boolean;
    audio: HTMLAudioElement;
    load(i: number, autoplay?: boolean): void;
    toggle(): void;
    next(): void;
    prev(): void;
    seekTo(t: number): void;
    setVolume(v: number): void;
    freq(): Uint8Array | null;
  }

  createEngine();

  /* ============ 迷你播放条 UI ============
     ClientRouter 会重执行页面脚本：用全局一次性守卫防止对持久元素重复绑定
     （双绑定会让一次点击触发两次 toggle = 播放即暂停）。
     二次执行时仅刷新同步。 */
  const w2 = window as unknown as Record<string, unknown>;
  const setupUI = () => {
    const root = document.getElementById('mini-player');
    const titleEl = document.getElementById('mp-title');
    const toggleBtn = document.getElementById('mp-toggle');
    const closeBtn = document.getElementById('mp-close');
    const vis = root?.querySelector<HTMLCanvasElement>('.mp-vis');
    const vctx = vis?.getContext('2d');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const sync = () => {
      const api = createEngine();
      const active = api.index >= 0;
      root?.toggleAttribute('hidden', !active || location.pathname.startsWith('/lab/music'));
      if (toggleBtn) {
        toggleBtn.classList.toggle('is-playing', api.playing);
      }
      if (titleEl && api.index >= 0) {
        titleEl.textContent = api.tracks[api.index].title;
      }
    };

    window.addEventListener('noxaudio:state', sync);
    // 路由切换后重估显隐（播放页隐藏迷你条）并刷新状态
    document.addEventListener('astro:page-load', sync);
    sync();

    if (toggleBtn && !toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = '1';
      toggleBtn.addEventListener('click', () => createEngine().toggle());
    }
    if (closeBtn && !closeBtn.dataset.bound) {
      closeBtn.dataset.bound = '1';
      closeBtn.addEventListener('click', () => {
        const api = createEngine();
        api.audio.pause();
        root?.setAttribute('hidden', '');
      });
    }

    // 迷你频谱：仅播放中绘制，节流到 ~20fps
    if (root && vctx && !reduced.matches && !root.dataset.visBound) {
      root.dataset.visBound = '1';
      let last = 0;
      const draw = (t: number) => {
        requestAnimationFrame(draw);
        if (t - last < 50) return;
        last = t;
        const api = createEngine();
        if (api.index < 0 || !api.playing || !vctx) return;
        // 顺手同步播放/暂停图标状态（跨页后防滞后）
        toggleBtn?.classList.toggle('is-playing', api.playing);
        const freq = api.freq();
        if (!freq) return;
        const w = vis.width;
        const h = vis.height;
        vctx.clearRect(0, 0, w, h);
        const bars = 14;
        const bw = w / bars;
        for (let i = 0; i < bars; i++) {
          const v = freq[Math.floor((i / bars) * 80)] / 255;
          const bh = Math.max(2, v * h);
          vctx.fillStyle = `rgba(168, 85, 247, ${0.45 + v * 0.5})`;
          vctx.fillRect(i * bw + 1.5, h - bh, bw - 3, bh);
        }
      };
      requestAnimationFrame(draw);
    }
  };

  if (!w2.noxMiniUI) {
    w2.noxMiniUI = true;
  }
  setupUI();
</script>

<style>
  .mini-player {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 150;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 12px;
    border-radius: var(--radius-pill);
    background: rgba(19, 11, 34, 0.88);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-pop);
  }

  .mp-open {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    min-width: 0;
  }

  .mp-vis {
    display: block;
    border-radius: 6px;
    background: var(--color-bg-inset);
  }

  .mp-title {
    font-size: 0.85rem;
    color: var(--color-text);
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mp-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .mp-btn:hover {
    background: rgba(168, 157, 220, 0.12);
  }

  .mp-btn .ic {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .ic-pause {
    display: none;
  }

  .is-playing .ic-play {
    display: none;
  }

  .is-playing .ic-pause {
    display: block;
  }

  .mp-close .ic {
    width: 13px;
    height: 13px;
  }

  @media (max-width: 640px) {
    .mini-player {
      right: var(--space-3);
      bottom: var(--space-3);
    }

    .mp-title {
      max-width: 96px;
    }
  }
</style>
