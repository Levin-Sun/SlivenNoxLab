---
// 全局导航：透明 → 滚动后毛玻璃（IntersectionObserver 哨兵，不用 scroll 监听）。
// 配置驱动：增删模块只改 src/config/nav.ts
import { navItems } from '../config/nav';

const { pathname } = Astro.url;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="site-nav" data-scrolled="false">
  <div class="container nav-inner">
    <a class="nav-logo" href="/">Sliven<span class="logo-nox">Nox</span>Lab</a>

    <nav class="nav-links" aria-label="主导航">
      {
        navItems
          .filter((item) => item.href !== '/')
          .map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
      }
    </nav>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开菜单">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="移动端导航" hidden>
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out);
  }

  .site-nav[data-scrolled='true'] {
    background: rgba(10, 6, 20, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .logo-nox {
    color: var(--color-accent-soft);
  }

  .nav-links {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-text);
    background: rgba(168, 157, 220, 0.08);
  }

  .nav-links a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    align-items: center;
    border-radius: var(--radius-input);
  }

  .nav-toggle .bar {
    width: 18px;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav-toggle[aria-expanded='true'] .bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    padding: 104px 24px 24px;
    display: grid;
    align-content: start;
    gap: 2px;
    background: rgba(6, 3, 16, 0.96);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  /* display:grid 会压过 hidden 属性的 UA 样式，必须显式夺回 */
  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    padding: 14px 8px;
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
    const header = document.querySelector<HTMLElement>('.site-nav');
    const sentinel = document.querySelector<HTMLElement>('.nav-sentinel');
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');

    // 滚动毛玻璃：哨兵离开视口即切换状态，避免 scroll 事件逐帧触发
    if (header && sentinel) {
      new IntersectionObserver(([entry]) => {
        header.dataset.scrolled = String(!entry.isIntersecting);
      }).observe(sentinel);
      // 路由切换后立即校准一次（新页可能初始就处于滚动状态）
      header.dataset.scrolled = String(window.scrollY > 8);
    }

    const setOpen = (open: boolean) => {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle?.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
</script>
