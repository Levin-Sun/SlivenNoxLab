---
// Hero 紫色光场 v3 —— 逆向自参考站 Limited 的 UnicornStudio "black hole" 场景。
// 原配方（assets.unicorn.studio/embeds/vTTCp5g4cVl9nwjlT56Z）：
//   wisps 层：双 voronoi 星点网格 y 压扁 3% → 横向光丝，闪烁 + 缓慢纵向流动（加法混色）
//   beam 层：中心光环 + 90° 亮弧每 100 秒扫掠一周（雷达式）
//   定色机制：场景渲染深青色，外层 CSS filter: hue-rotate(90deg) 转为品牌紫
// 本实现把两层合并为单 pass 原生 WebGL 着色器，沿用同一 hue-rotate 定色机制，
// 并按需求增加指针交互（视差 + 辉光跟随）。降级链：WebGL → 交互式 2D 光斑 → 纯 CSS。
// 强制切换：?aurora=css | ?aurora=2d
---

<div class="aurora" data-variant="css" aria-hidden="true">
  <div class="aurora-css"></div>
  <canvas class="aurora-2d"></canvas>
  <canvas class="aurora-gl"></canvas>
</div>

<style>
  .aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .aurora canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  /* Limited 同款定色机制：场景渲染青色，色相旋转 90° 得品牌紫 */
  .aurora[data-variant='gl'] .aurora-gl,
  .aurora[data-variant='2d'] .aurora-2d {
    display: block;
    filter: hue-rotate(90deg);
  }

  .aurora-css {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(38% 34% at 20% 18%, rgba(124, 58, 237, 0.32), transparent 70%),
      radial-gradient(32% 36% at 76% 22%, rgba(168, 85, 247, 0.24), transparent 70%),
      radial-gradient(44% 40% at 52% 92%, rgba(91, 33, 182, 0.28), transparent 72%);
    filter: blur(70px);
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }

  .aurora:not([data-variant='css']) .aurora-css {
    display: none;
  }

  @keyframes aurora-drift {
    to {
      transform: translate(-4%, 3%) rotate(4deg) scale(1.08);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.aurora');

  if (root) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const forced = new URLSearchParams(location.search).get('aurora');

    /* ---------------- 指针跟踪（平滑跟随） ---------------- */
    const pointer = { x: 0.72, y: 0.3, tx: 0.72, ty: 0.3 };
    window.addEventListener(
      'pointermove',
      (e) => {
        pointer.tx = e.clientX / innerWidth;
        pointer.ty = 1 - e.clientY / innerHeight;
      },
      { passive: true },
    );

    const makeLoop = (paint: (t: number) => void, fps = 30) => {
      let raf = 0;
      let last = 0;
      let running = false;
      const start = () => {
        if (running || reduced.matches) return;
        running = true;
        raf = requestAnimationFrame(loop);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };
      const loop = (t: number) => {
        raf = requestAnimationFrame(loop);
        if (t - last < 1000 / fps) return;
        last = t;
        pointer.x += (pointer.tx - pointer.x) * 0.06;
        pointer.y += (pointer.ty - pointer.y) * 0.06;
        paint(t);
      };
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      reduced.addEventListener?.('change', () => stop());
      start();
    };

    /* ---------------- 层 1：WebGL 复刻 wisps + beam（首选） ---------------- */
    const initGL = (): boolean => {
      const canvas = root.querySelector<HTMLCanvasElement>('.aurora-gl');
      const gl = canvas?.getContext('webgl', { antialias: false, alpha: false });
      if (!canvas || !gl) return false;

      const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';

      // 单 pass 复刻：wisps（双压扁 voronoi 光丝）+ beam（扫掠光环）+ 伪 bloom + vignette
      // 颜色沿用原场景深青色，定色交给外层 CSS hue-rotate(90deg)
      const FRAG = `
precision highp float;
uniform vec2 uRes;
uniform float uTime;
uniform vec2 uMouse;

vec2 hash2(vec2 p){
  p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
  return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float hash1(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }

/* 加法 voronoi 星点场（与原 wisps 层同源公式） */
float voro(vec2 st, float radius){
  vec2 i = floor(st);
  float total = 0.0;
  for (int y = -2; y <= 2; y++)
  for (int x = -2; x <= 2; x++){
    vec2 cell = i + vec2(float(x), float(y));
    vec2 h = hash2(cell);
    vec2 p = 0.5 + 0.5 * sin(5.0 + 6.2831 * h);
    vec2 sp = cell + p;
    float d = length(sp - st);
    float c = radius / max(d, radius * 0.1);
    float phase = (p.x + p.y) * 10.0 + h.x * 5.0 + uTime * 0.5;
    c *= sin(phase) + 1.0;
    total += mix(c * c, c * 2.0, 0.25);
  }
  return total;
}

/* 中心光环 + 100 秒一周的 90° 扫掠亮弧（与原 beam 层同源公式） */
float ringBeam(vec2 uv, vec2 center){
  float aspect = uRes.x / uRes.y;
  vec2 st = vec2(uv.x * aspect, uv.y);
  vec2 c = vec2(center.x * aspect, center.y);
  float ringDist = abs(length(st - c) - 0.285);
  float brightness = 0.0775 / (1.0 - smoothstep(0.2, 0.002, ringDist + 0.02));
  float sweep = fract(uTime * 0.01 + 1.0) * 6.28318530718;
  float ang = atan(st.y - c.y, st.x - c.x);
  if (ang < 0.0) ang += 6.28318530718;
  float diff = abs(ang - sweep);
  if (diff > 3.14159265) diff = 6.28318530718 - diff;
  brightness *= 1.04 - smoothstep(0.0, 1.5708, diff);
  return brightness * pow(max(1.0 - ringDist, 0.0), 3.0);
}

void main(){
  vec2 uv = gl_FragCoord.xy / uRes;
  float aspect = uRes.x / uRes.y;

  /* 指针视差：整场轻微偏移（自加交互，原场景此参数为关） */
  vec2 par = (uMouse - 0.5) * 0.05;

  /* wisps：y 压扁 0.03 的双 voronoi 网格，纵向缓慢流动；横向正弦摆动制造弧度 */
  vec2 p = (uv - 0.5) - par;
  vec2 pa = vec2(p.x * aspect, p.y);
  float flow = uTime * 0.025;
  vec2 g1 = pa * 28.5 * vec2(1.0, 0.03) + vec2(0.0, -flow);
  vec2 g2 = pa * 36.0 * vec2(1.0, 0.03) + vec2(10.0, -flow);
  g1.x += sin(pa.y * 6.0 + uTime * 0.12) * 0.9;
  g2.x += sin(pa.y * 4.0 - uTime * 0.09 + 2.0) * 1.3;
  float w = voro(g1, 0.45) * 0.02 + voro(g2, 0.45) * 0.04;
  /* 轻晕染软化热核边缘；间隙保持纯黑（晕染只跟 sqrt 走，不抬底） */
  vec3 col = vec3(0.0, 0.18, 0.1725) * (w + sqrt(max(w, 0.0)) * 0.15);

  /* beam：扫掠光环（压暗提柔，避免几何感太硬） */
  vec2 c = vec2(0.5) - par * 0.5;
  float beam = ringBeam(uv, c);
  col += vec3(0.0, 0.243, 0.231) * beam / (1.0 + beam * beam) * 0.7;

  /* 指针辉光（自加交互） */
  vec2 su = vec2(uv.x * aspect, uv.y);
  vec2 m = vec2(uMouse.x * aspect, uMouse.y);
  col += vec3(0.0, 0.30, 0.28) * exp(-length(su - m) * 4.5) * 0.4;

  /* 伪 bloom：热区增强（原场景为 9 pass 高斯，此处单 pass 近似） */
  float luma = dot(col, vec3(0.299, 0.587, 0.114));
  col += smoothstep(0.2, 0.9, luma) * col * 0.7;

  /* 边缘 vignette */
  col *= 1.0 - 0.4 * smoothstep(0.5, 1.02, length(uv - 0.5));

  /* 抖动去色带（原 grain 层低配版，DOM 噪点层另有全局质感） */
  col += (hash1(gl_FragCoord.xy + fract(uTime) * 100.0) - 0.5) / 255.0;

  gl_FragColor = vec4(max(col, vec3(0.0)), 1.0);
}`;

      const compile = (type: number, src: string) => {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
          console.warn('[aurora] shader error:', gl.getShaderInfoLog(s));
          return null;
        }
        return s;
      };

      const vs = compile(gl.VERTEX_SHADER, VERT);
      const fs = compile(gl.FRAGMENT_SHADER, FRAG);
      if (!vs || !fs) return false;
      const prog = gl.createProgram()!;
      gl.attachShader(prog, vs);
      gl.attachShader(prog, fs);
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return false;
      gl.useProgram(prog);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const uRes = gl.getUniformLocation(prog, 'uRes');
      const uTime = gl.getUniformLocation(prog, 'uTime');
      const uMouse = gl.getUniformLocation(prog, 'uMouse');

      // 着色器含 2×25 格 voronoi，60% 分辨率渲染在观感与帧率间取平衡
      const isSmall = matchMedia('(max-width: 768px)').matches;
      const scale = isSmall ? 0.4 : 0.6;
      const resize = () => {
        canvas.width = Math.max(2, Math.ceil(canvas.clientWidth * scale));
        canvas.height = Math.max(2, Math.ceil(canvas.clientHeight * scale));
        gl.viewport(0, 0, canvas.width, canvas.height);
      };
      resize();

      const paint = (t: number) => {
        gl.uniform2f(uRes, canvas.width, canvas.height);
        gl.uniform1f(uTime, t);
        gl.uniform2f(uMouse, pointer.x, pointer.y);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(resize, 120);
      });

      root.dataset.variant = 'gl';
      if (reduced.matches) {
        paint(40000);
        return true;
      }
      makeLoop((t) => paint(t), 30);
      return true;
    };

    /* ---------------- 层 2：Canvas 2D 光斑降级（交互式） ---------------- */
    const init2D = (): boolean => {
      const canvas = root.querySelector<HTMLCanvasElement>('.aurora-2d');
      const ctx = canvas?.getContext('2d');
      if (!canvas || !ctx) return false;

      const blobs = [
        { x: 0.16, y: 0.12, r: 0.44, h: 268, a: 0.3, px: 0.00013, py: 0.00009, ph: 0.00004 },
        { x: 0.68, y: 0.2, r: 0.4, h: 292, a: 0.26, px: 0.00011, py: 0.00012, ph: 0.00005 },
        { x: 0.55, y: 0.88, r: 0.5, h: 256, a: 0.24, px: 0.00007, py: 0.00011, ph: 0.00003 },
        { x: 0.9, y: 0.55, r: 0.3, h: 305, a: 0.18, px: 0.00014, py: 0.00008, ph: 0.00006 },
      ];

      const resize = () => {
        canvas.width = Math.max(2, Math.ceil(canvas.clientWidth / 8));
        canvas.height = Math.max(2, Math.ceil(canvas.clientHeight / 8));
      };
      resize();

      const paint = (t: number) => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.globalCompositeOperation = 'lighter';
        blobs.forEach((b, i) => {
          const drift = i === 0 ? { x: pointer.x * 0.25, y: pointer.y * 0.25 } : { x: 0, y: 0 };
          const x = (b.x + Math.sin(t * b.px) * 0.08 + drift.x) * canvas.width;
          const y = (b.y + Math.cos(t * b.py) * 0.09 + drift.y) * canvas.height;
          const r = b.r * Math.min(canvas.width, canvas.height) * (1 + Math.sin(t * b.ph) * 0.1);
          const g = ctx.createRadialGradient(x, y, 0, x, y, r);
          g.addColorStop(0, `hsla(${b.h + Math.sin(t * b.ph) * 6}, 78%, 60%, ${b.a})`);
          g.addColorStop(1, 'hsla(0, 0%, 0%, 0)');
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        });
      };

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resize();
          paint(performance.now());
        }, 120);
      });

      root.dataset.variant = '2d';
      paint(0);
      if (!reduced.matches) makeLoop((t) => paint(t), 30);
      return true;
    };

    /* ---------------- 变体选择 ---------------- */
    if (forced !== 'css') {
      const ok = (forced !== '2d' && initGL()) || init2D();
      if (ok) {
        (root.querySelector('.aurora-css') as HTMLElement).style.display = 'none';
      }
    }
  }
</script>
